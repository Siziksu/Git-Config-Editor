{
  "name": "git-config-info",
  "displayName": "Git Editor",
  "description": "Displays and edits Git information for the current project",
  "version": "1.2.0",
  "publisher": "siziksu",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Siziksu/Git-Config-Editor"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-config-info.refreshGitDetails",
        "title": "Refresh",
        "category": "Siziksu Git Editor",
        "icon": "$(refresh)"
      },
      {
        "command": "git-config-info.openGitConfigFile",
        "title": "Open Git Config File",
        "category": "Siziksu Git Editor",
        "icon": "$(code)"
      },
      {
        "command": "git-config-info.toggleGitConfig",
        "title": "Toggle",
        "category": "Siziksu Git Editor",
        "icon": "$(sync)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitDetailsSidebar",
          "title": "Siziksu Git Editor",
          "icon": "$(github-alt)"
        }
      ]
    },
    "views": {
      "gitDetailsSidebar": [
        {
          "id": "gitEditorView",
          "name": "Siziksu Git Editor",
          "icon": "$(github)"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "git-config-info.toggleGitConfig",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "git-config-info.openGitConfigFile",
          "when": "view == gitEditorView",
          "group": "navigation"
        },
        {
          "command": "git-config-info.refreshGitDetails",
          "when": "view == gitEditorView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "git-config-info.toggleGitConfig",
          "when": "view == gitEditorView && viewItem == toggleConfig",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
